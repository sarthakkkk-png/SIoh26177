# AetherSAR backend - optional Supabase persistence
#
# Copy this file to `.env` (never commit it) and fill in real values, or
# export the variables in your shell / run:
#
#   python3 -m uvicorn backend.main:app --reload --env-file .env
#
# When BOTH variables are set (SUPABASE_URL must be an http(s) URL), the
# backend persists missions, search paths, search cells, telemetry,
# detections, drones, alerts, mission events, media and report metadata to
# Supabase/PostgreSQL.
#
# When they are missing or empty, the backend starts normally and uses the
# in-memory store (offline development; data is lost on restart).
#
# The key is used backend-side only and must never be exposed to a client.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
